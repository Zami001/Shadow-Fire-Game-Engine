{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "include": [
  ],
  "configurePresets": [
    {
      "name": "base",
      "description": "Base configuration to use for all build presets",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "debug-base",
      "hidden": true,
      "description": "Base configuration for debug builds",
      "inherits": [ "base" ],
      "cacheVariables": {
        "SF_DEBUG": true,
        "SF_PROFILING": true,
        "SF_USE_ASSERTS": true,
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "description": "Base configuration for release builds",
      "cacheVariables": {
        "SF_DEBUG": false,
        "SF_PROFILING": false,
        "SF_USE_ASSERTS": false,
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "editor-base",
      "hidden": true,
      "description": "Base configuration for editor builds",
      "cacheVariables": {
        "SF_EDITOR": true
      }
    },
    {
      "name": "editor-debug",
      "displayName": "Editor Debug",
      "description": "Shadow fire editor with debug symbols and debug tools",
      "inherits": [ "editor-base", "debug-base" ]
    },
    {
      "name": "editor-release",
      "displayName": "Editor Release",
      "description": "Release build of the Shadow Fire editor",
      "inherits": [ "editor-base", "release-base" ]
    }
  ]
}